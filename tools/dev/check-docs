"""
Checks the repo's Markdown files:
  1. Every link to another file in the repo points at a file that exists.
     Web links (http, https, mailto) aren't checked: that needs the network.
  2. Decision records in docs/decisions/ are named NNNN-short-name.md, and no
     number is used twice, counting records deleted earlier: numbers are
     never reused (AGENTS.md, "Decision records").
Prints each problem as file:line, and exits 1 if there were any.
Usage: tools/dev/check-docs   (part of tools/dev/check)
"""

import os
import re
import subprocess
import sys
from urllib.parse import unquote

repo = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
LINK = re.compile(r"\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\)")
REFERENCE = re.compile(r"^\s{0,3}\[[^\]]+\]:\s*<?(\S+?)>?(\s|$)")
FENCE = re.compile(r"^\s{0,3}(```|~~~)")
CODE_SPAN = re.compile(r"`+[^`]*`+")
RECORD = re.compile(r"^(\d{4})-[a-z0-9]+(-[a-z0-9]+)*\.md$")


def git(*args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, check=True).stdout


def markdown_files():
    names = git("ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", "*.md").split("\0")
    return sorted({n for n in names if n and os.path.isfile(os.path.join(repo, n))})


def check_links(name, problems):
    folder = os.path.dirname(os.path.join(repo, name))
    in_fence = False
    with open(os.path.join(repo, name), encoding="utf-8") as f:
        for number, line in enumerate(f, 1):
            if FENCE.match(line):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            text = CODE_SPAN.sub("", line)
            targets = [m.group(1) for m in LINK.finditer(text)]
            ref = REFERENCE.match(text)
            if ref:
                targets.append(ref.group(1))
            for target in targets:
                if "://" in target or target.startswith(("mailto:", "#", "[")):
                    continue
                path = unquote(target.split("#", 1)[0].split("?", 1)[0])
                if not path:
                    continue
                full = os.path.normpath(os.path.join(repo, path.lstrip("/")) if path.startswith("/")
                                        else os.path.join(folder, path))
                if not (full == repo or full.startswith(repo + os.sep)):
                    problems.append(f"{name}:{number}: link points outside the repo: {target}")
                elif not os.path.exists(full):
                    problems.append(f"{name}:{number}: link to a missing file: {target}")


def check_records(problems):
    folder = "docs/decisions"
    current = sorted(os.listdir(os.path.join(repo, folder)))
    deleted = {os.path.basename(n) for n in
               git("log", "--diff-filter=D", "--name-only", "--format=", "--", folder).split()}
    used = {}
    for name in current:
        m = RECORD.match(name)
        if not m:
            problems.append(f"{folder}/{name}: not named NNNN-short-name.md (lower case, hyphens)")
            continue
        used.setdefault(m.group(1), []).append(name)
    for number, names in sorted(used.items()):
        if len(names) > 1:
            problems.append(f"{folder}: number {number} is used by {', '.join(names)}")
        for old in sorted(deleted):
            if old.startswith(number + "-") and old not in names:
                problems.append(f"{folder}/{names[0]}: number {number} was already used by "
                                f"the deleted {old}; numbers are never reused")


def main():
    problems = []
    for name in markdown_files():
        check_links(name, problems)
    check_records(problems)
    for problem in problems:
        print(problem)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
