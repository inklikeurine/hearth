#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Builds Hearth and runs every check: tests, QML and C++ linters, formatting and
# the secret scan. Prints PASS or FAIL for each, and fails if any failed.
#   tools/dev/check            check everything; run this before every commit
#   tools/dev/check --quick    while working: clang-tidy only reads the C++ files
#                              changed since the last commit, and those that
#                              include a changed header
#   tools/dev/check --fix      also reformat the code in place
#   tools/dev/check --staged   only the fast checks, on the files staged for a
#                              commit: formatting, ShellCheck, doc links, and the
#                              Claude guard's cases if the guard changed. The
#                              pre-commit hook runs this. It reads the files on
#                              disk, which differ from what's staged only when
#                              part of a file was staged.
# It uses 6 cores at low priority, so the desktop stays usable.

# ShellCheck can't see that step() calls the check functions by name.
# shellcheck disable=SC2329
set -uo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [[ ! -f /run/.containerenv ]]; then
    exec distrobox enter hearth-f45 -- "$repo/tools/dev/check" "$@"
fi
cd "$repo" || exit 1
renice -n 10 $$ >/dev/null
qt=/usr/lib64/qt6/bin
build=build
jobs=6
quick=0 fix=0 staged=0
for arg in "$@"; do
    case "$arg" in
    --quick) quick=1 ;;
    --fix) fix=1 ;;
    --staged) staged=1 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
    esac
done
mapfile -t cpp < <(find src tests -name '*.cpp' -o -name '*.h' | sort)
mapfile -t units < <(find src tests -name '*.cpp' | sort)
mapfile -t qml < <(find src tests -name '*.qml' | sort)
# Shell scripts: tracked files whose first line starts a shell
mapfile -t shells < <(git ls-files | while read -r file; do
    [[ -f "$file" ]] && head -n 1 "$file" | grep -qE '^#!.*\b(ba)?sh\b' && echo "$file"
done)

# --staged: keep only the files staged for the commit
if ((staged)); then
    mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
    keep() {
        local file
        for file in "$@"; do
            printf '%s\n' "${files[@]}" | grep -qxF -- "$file" && echo "$file"
        done
    }
    mapfile -t cpp < <(keep "${cpp[@]}")
    mapfile -t qml < <(keep "${qml[@]}")
    mapfile -t shells < <(keep "${shells[@]}")
fi

# --quick: clang-tidy reads only the changed .cpp files, plus the .cpp files that
# include a changed header (its warnings show up through them).
tidy=("${units[@]}")
if ((quick)); then
    mapfile -t changed < <({ git diff --name-only HEAD; git ls-files --others --exclude-standard; } \
        | grep -E '^(src|tests)/.*\.(cpp|h)$' | sort -u)
    tidy=()
    for file in "${changed[@]}"; do
        [[ -f "$file" ]] || continue
        if [[ "$file" == *.cpp ]]; then
            tidy+=("$file")
        else
            mapfile -t -O "${#tidy[@]}" tidy < <(grep -lF "\"$(basename "$file")\"" "${units[@]}")
        fi
    done
    mapfile -t tidy < <(printf '%s\n' "${tidy[@]}" | grep . | sort -u)
fi

if ((fix)); then
    clang-format -i "${cpp[@]}"
    "$qt/qmlformat" -i "${qml[@]}"
fi

failed=0
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
step() {  # name, command...: run quietly, show the output only on failure
    local name="$1"
    shift
    if "$@" >"$log" 2>&1; then
        echo "PASS  $name"
    else
        echo "FAIL  $name"
        sed 's/^/      /' "$log"
        failed=1
    fi
}

# ccache keeps compiled files, so a clean or reconfigured build reuses them; mold links faster.
configure() {
    cmake -S . -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_COMPILE_WARNING_AS_ERROR=ON \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_LINKER_TYPE=MOLD
}
compile() { cmake --build "$build" -j "$jobs"; }
run_tests() { ctest --test-dir "$build" --output-on-failure --no-tests=error; }
# Qt's own all_qmllint target passes even when it prints warnings; -W 0 doesn't.
lint_qml() { "$qt/qmllint" -W 0 -I "$build/qml" "${qml[@]}"; }
format_qml() {
    local file bad=0
    for file in "${qml[@]}"; do
        "$qt/qmlformat" "$file" | diff -u "$file" - || bad=1
    done
    return "$bad"
}

format_cpp() {
    ((${#cpp[@]})) || return 0
    clang-format --dry-run -Werror "${cpp[@]}"
}
lint_shell() {
    ((${#shells[@]})) || return 0
    shellcheck "${shells[@]}"
}
shell_step() {  # ShellCheck is new to the box; skip it until it's installed
    if command -v shellcheck >/dev/null 2>&1; then
        step "shellcheck" lint_shell
    else
        echo "SKIP  shellcheck (not installed in the box yet)"
    fi
}
docs_step() { step "doc links and decision numbers" python3 -I tools/dev/check-docs; }
guard_step() { step "Claude guard cases" python3 -I .claude/hooks/test-git-guard.py; }

if ((staged)); then
    step "clang-format" format_cpp
    step "qmlformat" format_qml
    shell_step
    docs_step
    if printf '%s\n' "${files[@]}" | grep -q '^\.claude/hooks/'; then
        guard_step
    fi
    exit "$failed"
fi

step "configure" configure
step "build" compile
step "tests" run_tests
step "qmllint" lint_qml
step "qmlformat" format_qml
# Several files at once; xargs fails if any clang-tidy run does.
lint_cpp() {
    ((${#tidy[@]})) || return 0
    printf '%s\0' "${tidy[@]}" | xargs -0 -P "$jobs" -n 2 clang-tidy -p "$build" --quiet
}
# clazy: Qt-specific C++ checks, level 1 (the ones its makers call safe for any
# Qt code). Its warnings fail the run because the build treats warnings as errors.
lint_qt() {
    ((${#tidy[@]})) || return 0
    printf '%s\0' "${tidy[@]}" | xargs -0 -P "$jobs" -n 2 clazy-standalone -p "$build" \
        --checks=level1 --ignore-dirs="^$repo/$build/"
}
if ((quick)); then
    step "clang-tidy (${#tidy[@]} changed files)" lint_cpp
    step "clazy (${#tidy[@]} changed files)" lint_qt
else
    step "clang-tidy" lint_cpp
    step "clazy" lint_qt
fi
step "clang-format" format_cpp
shell_step
docs_step
guard_step
step "gitleaks" gitleaks dir --no-banner --redact --log-level warn src tests tools
exit "$failed"
